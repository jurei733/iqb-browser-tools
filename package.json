{
  "name": "iqb-browser-port",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start:local": "node scripts/local-app.mjs --open",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "pnpm build && node scripts/build-browser-tests.mjs work/browser-tests && playwright test",
    "test:reference": "node scripts/test-reference.mjs",
    "test:study": "node scripts/testcenter-study.mjs",
    "test:differential": "node scripts/analyze-windows-differential.mjs",
    "audit:functions": "node scripts/audit-functions.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "jsonc-parser": "3.3.1",
    "lossless-json": "^4.3.3",
    "qrcode": "^1.5.4",
    "sql.js": "^1.13.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@xmldom/xmldom": "^0.8.11",
    "vite": "^7.1.0"
  }
}
